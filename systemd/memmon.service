[Unit]
Description=memmon - memory usage logger
Documentation=man:memmon(1)
After=local-fs.target

[Service]
Type=simple
# Runs as the unprivileged "memmon" system user (created from
# /usr/lib/sysusers.d/memmon.conf). Reading /proc and /sys needs no
# privileges.
User=memmon
Group=memmon

# LogsDirectory= makes systemd create /var/log/memmon owned by memmon
# before ExecStart runs (and fixes ownership of logs written by older,
# root-run versions). It is also the only path the service may write to
# under ProtectSystem=strict below. Mode 0755 keeps the logs readable by
# other users, e.g. for `memmon --report`.
LogsDirectory=memmon
LogsDirectoryMode=0755

# All settings (interval, log directory/format/retention, thresholds,
# alert command, ...) are read by memmon itself from
# /etc/memmon/memmon.conf. Edit it, then apply with
# `systemctl reload memmon` (or restart).
#
# Using a MEMMON_LOG_DIR other than /var/log/memmon? That directory must
# be writable by the memmon user AND made writable for the service:
#   sudo systemctl edit memmon
#   [Service]
#   ReadWritePaths=/your/log/dir
ExecStart=/usr/bin/memmon --daemon
ExecReload=/bin/kill -HUP $MAINPID

# Restart automatically if it ever crashes; it otherwise loops forever.
Restart=on-failure
RestartSec=5
Nice=10

# Hardening. MEMMON_ALERT_CMD hooks run inside this sandbox too; network
# access (AF_INET/AF_INET6) is left available so hooks can call webhooks
# or send mail, and MemoryDenyWriteExecute= is not set so hooks written in
# JIT runtimes (node, java) still work. /proc stays fully visible so the
# top-processes view works.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0022

[Install]
WantedBy=multi-user.target

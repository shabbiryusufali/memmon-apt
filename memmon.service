[Unit]
Description=memmon - memory usage logger
Documentation=man:memmon(1)
After=local-fs.target

[Service]
Type=simple
# LogsDirectory= makes systemd create /var/log/memmon (mode 0755, owned by
# the service's User=/Group=) before ExecStart runs, and removes it again
# only if RuntimeDirectoryPreserve isn't set - log files persist across
# restarts either way since this just controls the directory itself.
LogsDirectory=memmon
ExecStart=/usr/local/bin/memmon --daemon --interval 5m --log-dir /var/log/memmon

# Restart automatically if it ever crashes; it otherwise loops forever.
Restart=on-failure
RestartSec=5

# Modest hardening - relax these if your environment needs to.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/memmon
PrivateTmp=true
Nice=10

[Install]
WantedBy=multi-user.target
